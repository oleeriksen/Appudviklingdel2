@page "/counter/{delta:int}"
@page "/counter"
@inject Blazored.LocalStorage.ILocalStorageService localStore


<PageTitle>Counter</PageTitle>

<h1>Counter</h1>
@if (currentCount == 4)
{
    <p role="status" style="color: red">Current count: @currentCount</p>
}
else
{
    <p role="status" style="color: black">Current count: @currentCount</p>
}

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>
<button class="btn btn-primary" @onclick="ResetCount">Reset</button>

@code {
    [Parameter] public int? delta { get; set; } = 1;
    
    private int? currentCount = 0;

    protected override async Task OnInitializedAsync()
    {
        int? data = await localStore.GetItemAsync<int?>("count");
        currentCount = data ?? 0;
        /* the semantic is
         if (data is null)
            currentCount = 0;
        else
            currentCount = data.Value; */
        if (delta is null)
            delta = 1;
        else
        {
            delta = delta.Value;
        }
    }

    private async Task IncrementCount()
    {
        currentCount = currentCount + delta;
        await localStore.SetItemAsync<int?>("count", currentCount);
    }

    private async Task ResetCount()
    {
        currentCount++;
        await localStore.SetItemAsync<int?>("count", currentCount);
    }

}