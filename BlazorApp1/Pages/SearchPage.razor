@page "/search"
@inject HttpClient Http

<h3>Search Page</h3>

<input type="text" @bind="userInput" @bind:event="oninput">
<br><br>
<button class="btn btn-primary" @onclick="OnStartsWith">Starts With</button>
<button class="btn btn-primary" @onclick="OnContains">Contains</button>
<button class="btn btn-primary" @onclick="OnDistance1">Distance 1</button>
<br><br>
<p>@searchString</p>

@if (viewedWords != null)
{
    <ul>
        @foreach (string word in viewedWords)
        {
            <li>@word</li>
        }
    </ul>
    
    @if (viewedWords != null && displayCount > 10)
    {
        <button class="btn btn-secondary btn-sm" @onclick="ShowLess">Show Less</button>
    }
    @if (searchResults != null && displayCount < searchResults.Length)
    {
        <button class="btn btn-secondary btn-sm" @onclick="ShowMore">Show More</button>
    }
}
else
{
    <p>Waiting for words to be loaded...</p>
}

@code {
    string serverUrl = "http://localhost:5029/api/word";
    string[]? viewedWords; // the words visible on the page
    string[]? searchResults;
    private string userInput = ""; // used @bind in input field to fill out the empty string
    private string searchString = ""; // @bind paragraph to show text string for results
    private int displayCount = 10;
    
    protected override async Task OnInitializedAsync()
    {
        
        searchResults = await Http.GetFromJsonAsync<string[]>($"{serverUrl}/first/100");
        displayCount = 10;
        UpdateView();
    }
    
    private void UpdateView()
    {
        if (searchResults == null) return;
        viewedWords = searchResults.Take(displayCount).ToArray();
    }
    
    private void ShowMore()
    {
        displayCount += 10;
        UpdateView();
    }
    
    private void ShowLess()
    {
        displayCount -= 10;
        UpdateView();
    }

    private async Task OnStartsWith()
    {
        
        //searchResults = await Http.GetFromJsonAsync<string[]>($"{serverUrl}/startswith/{userInput}");
        searchResults = await Http.GetFromJsonAsync<string[]>($"{serverUrl}/startswith?searchword={userInput}");

        displayCount = 10;
        UpdateView();
        searchString = $"Your search resulted in {searchResults.Length} word(s) starting with '{userInput}'";   
    }

    private async Task OnContains()
    {
        searchResults = await Http.GetFromJsonAsync<string[]>($"{serverUrl}/contains/{userInput}");
        displayCount = 10;
        UpdateView();
        searchString = $"Your search resulted in {searchResults.Length} word(s) containing '{userInput}'";   
    }

    private async Task OnDistance1()
    {
        searchResults = await Http.GetFromJsonAsync<string[]>($"{serverUrl}/distance1/{userInput}");
        displayCount = 10;
        UpdateView();
        searchString = $"Your search resulted in {searchResults.Length} word(s) with distance 1 to '{userInput}'";   
    }
}