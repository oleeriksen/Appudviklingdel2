@page "/search"
@inject HttpClient Http

<h3>Search Page</h3>

<input type="text" @bind="userInput" @bind:event="oninput">
<br><br>
<button class="btn btn-primary" @onclick="OnStartsWith">Starts With</button>
<button class="btn btn-primary" @onclick="OnContains">Contains</button>
<button class="btn btn-primary" @onclick="OnDistance1">Distance 1</button>
<br><br>
<p>@searchString</p>

@if (viewedWords != null)
{
    <ul>
        @foreach (string word in viewedWords)
        {
            <li>@word</li>
        }
    </ul>
    
    @if (searchResults != null && displayCount < searchResults.Length)
    {
        <button class="btn btn-secondary btn-sm" @onclick="ShowMore">Show More</button>
    }
}
else
{
    <p>Waiting for words to be loaded...</p>
}

@code {
    string[]? viewedWords; // the words visible on the page
    string[]? wordsFromFile; // all the words stored
    string[]? searchResults;
    private string userInput = ""; // used @bind in input field to fill out the empty string
    private string searchString = ""; // @bind paragraph to show text string for results
    private int displayCount = 10;
    
    protected override async Task OnInitializedAsync()
    {
        wordsFromFile = await LoadAllWords();
        searchResults = wordsFromFile;
        displayCount = 10;
        UpdateView();
    }

    private async Task<string[]> LoadAllWords()
    {
        string content = await Http.GetStringAsync("sample-data/words.txt");
        return content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries); // added more splits
    }
    
    private void UpdateView()
    {
        if (searchResults == null) return;
        viewedWords = searchResults.Take(displayCount).ToArray();
    }
    
    private void ShowMore()
    {
        displayCount += 10;
        UpdateView();
    }

    private void OnStartsWith()
    {
        if (wordsFromFile == null) return;
        
        List<string> matches = new List<string>(); // list is easier to work with than array
        
        foreach (string word in wordsFromFile)
        {
            if (word.StartsWith(userInput, StringComparison.OrdinalIgnoreCase)) // ignore case
            {
                matches.Add(word);
            }
        }
        
        searchResults = matches.ToArray();
        displayCount = 10;
        UpdateView();
        
        if (searchResults.Length == 1)
        {
            searchString = $"Your search resulted in 1 word starting with '{userInput}'";   
        }
        else
        {
            searchString = $"Your search resulted in {searchResults.Length} words starting with '{userInput}'";   
        }
    }

    private void OnContains()
    {
        if (wordsFromFile == null) return;
        
        List<string> matches = new List<string>();
        
        foreach (string word in wordsFromFile)
        {
            if (word.Contains(userInput, StringComparison.OrdinalIgnoreCase))
            {
                matches.Add(word);
            }
        }
        
        searchResults = matches.ToArray();
        displayCount = 10;
        UpdateView();
        
        if (searchResults.Length == 1)
        {
            searchString = $"Your search resulted in 1 word containing '{userInput}'";   
        }
        else
        {
            searchString = $"Your search resulted in {searchResults.Length} words containing '{userInput}'";   
        }
    }

    private void OnDistance1()
    {
        if (wordsFromFile == null) return;

        List<string> matches = new List<string>();

        foreach (string word in wordsFromFile)
        {
            if (word.Length == userInput.Length)
            {
                int distance = 0;

                for (int i = 0; i < userInput.Length; i++)
                {
                    if (char.ToLower(word[i]) != char.ToLower(userInput[i]))
                    {
                        distance++;
                    }
                }

                if (distance <= 1)
                {
                    matches.Add(word);
                }
            }
        }

        searchResults = matches.ToArray();
        displayCount = 10;
        UpdateView();
        
        if (searchResults.Length == 1)
        {
            searchString = $"Your search resulted in 1 word with a distance of 1 from '{userInput}'";  
        }
        else
        {
            searchString = $"Your search resulted in {searchResults.Length} words with a distance of 1 from '{userInput}'";
        }
    }
}