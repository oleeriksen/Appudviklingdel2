@page "/weather"
@using Core
@inject HttpClient Http

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates fetching data from the server.</p>

<div class="row p3">
<div class="col-md-6 mb-3">
    <InputNumber @bind-Value="amount" class="form-control"></InputNumber>
</div>
<div class="col-md-6 mb-3">
    <button class="btn btn-primary" @onclick="OnClickFetch">Fetch</button>
</div>
</div>
@if (forecasts == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th aria-label="Temperature in Celsius">Temp. (C)</th>
            <th>Summary</th>
        </tr>
        </thead>
        <tbody>
        @foreach (WeatherForecast forecast in forecasts)
        {
            <tr>
                <td>@forecast.Date.ToShortDateString()</td>
                <td>@forecast.TemperatureC</td>
                <td>@forecast.Summary</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {

    private int amount = 10;
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>($"http://localhost:5029/api/vejr/random/{amount}");
    }
    

    private async Task OnClickFetch()
    {
        forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>($"http://localhost:5029/api/vejr/random/{amount}");

    }

}