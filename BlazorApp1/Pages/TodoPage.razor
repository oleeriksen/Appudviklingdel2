@page "/todo"
@using BlazorApp1.Components
@using Logic
<h3>TodoPage</h3>

@foreach (TodoItem item in items)
{
    <span class=@ClassforIsDone(item) @onclick="() => OnCheckItem(item)"></span>
    <span style="font-weight: bold; padding: 5px">@item.Text</span>
    <br/>
}

<ModalDialog Title="OPret en ny todo... version 2" @ref="AddDialog">
    <div class="row p-3">
        <div class="col-md-4 mb-3">
            <InputText placeholder = "enter title of todo item" class="form-control" @bind-Value="newItemText"></InputText>
        </div>
        <div class="col-md-2 mb-3">
            <button class="btn btn-primary" @onclick="OnClickOK">OK</button>
        </div>
    </div>
</ModalDialog>

<div class="col-md-2 mb-3">
    <button class="btn btn-primary" @onclick="OnClickAdd">Add</button>
</div>
@code {
    List<TodoItem> items = new();

    string newItemText = "";

    string status = "";

    ModalDialog AddDialog { get; set; }

    private void OnClickAdd()
    {
        AddDialog.Open();
    }

    private string ClassforIsDone(TodoItem item) => item.IsDone ? "bi bi-check-circle" : "bi bi-circle";

    private void OnCheckItem(TodoItem item)
    {
        item.IsDone = !item.IsDone;
    }

    private void OnClickOK()
    {
        items.Add(new TodoItem() { Text = newItemText });
        newItemText = "";
        AddDialog.Close();
    }

}