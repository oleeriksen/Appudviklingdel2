@page "/dice"
@using Logic;
@inject Blazored.LocalStorage.ILocalStorageService localStore

<h3>Dicecup</h3>

@foreach (int eyes in cup.Eyes())
{
    <img src=@PathTo(eyes) width="80"/>
    <span style="font-weight: bold; padding: 10px; font-size: large">@eyes</span>
}
<p>
    <button class="btn @OneLessButtonClass()" @onclick="OneLess">One less</button>
    <button class="btn btn-primary" @onclick="OnClickShake">Shake</button>
    <button class="btn btn-primary" @onclick="OneMore">One more</button>

</p>
@code {
    DiceCup cup = new DiceCup(2);


    protected override async Task OnInitializedAsync()
    {
        int? data = await localStore.GetItemAsync<int>("dicecount");
        cup = data is null ? new DiceCup(2) : new DiceCup(data.Value);
    }

    private string PathTo(int eyes) => $"images/dices/dice{eyes}.png";
    
    private void OnClickShake()
    {
        cup.Shake();
    }

    private async Task OneLess()
    {
        cup = new DiceCup(cup.Count - 1);
        await localStore.SetItemAsync("dicecount", cup.Count);

    }

    private string OneLessButtonClass() => cup.Count > 1 ? "btn-primary" : "disabled";

    private async Task OneMore()
    {
        cup = new DiceCup(cup.Count + 1);
        await localStore.SetItemAsync("dicecount", cup.Count);

    }

}