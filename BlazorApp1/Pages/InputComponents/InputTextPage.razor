@page "/it"

<h3>Input text</h3>


<input @bind="input" @bind:event="oninput" />


@foreach (var s in GetHistorik())
{
    <p>@s</p>
}

@code {

    string simpleInput = "";

    List<string> historik = new();

    string input = "";

    List<string> GetHistorik()
    {
        historik.Add($"Input received: {input}");
        return historik;
    }

    void OnInput(ChangeEventArgs e)
    {
        input = e.Value.ToString(); // input must be updated ...
        Console.WriteLine($"OnInput: content = {input}");
    }

    void Check()
    {
        Console.WriteLine($"Check: simpleInput = {simpleInput}");
        Console.WriteLine($"Check: input = {input}");
        simpleInput = "after check";
        input = "after check";
    }

}

